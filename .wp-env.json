{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "https://wordpress.org/wordpress-7.1.4.zip",
	"phpVersion": "8.5",
	"port": 8890,
	"testsPort": 8891,
	"mappings": {
		"wp-content/plugins": "./.local/site/wp-content/plugins",
		"wp-content/themes": "./.local/site/wp-content/themes",
		"wp-content/uploads": "./.local/site/wp-content/uploads",
		"wp-content/languages": "./.local/site/wp-content/languages",
		"wp-content/mu-plugins": "./wp-content/mu-plugins",
		"efoo-import": "./.local/import"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"AUTOMATIC_UPDATER_DISABLED": true,
		"WP_AUTO_UPDATE_CORE": false
	}
}
